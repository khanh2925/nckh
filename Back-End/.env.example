# Copy this file to ".env" in the same folder (Back-End) and fill in your values.
# ".env" is git-ignored: never commit real passwords.
# Neon gives "postgresql://USER:PASSWORD@HOST/DB?sslmode=require"; for Java write it as:
#   DB_URL=jdbc:postgresql://HOST/DB?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/airport_map
DB_USERNAME=airport_map
DB_PASSWORD=
# Admin login for this computer (Admin page on http://localhost:5173). Empty = nobody can log in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: a long random value keeps logins valid across restarts
JWT_SECRET=
