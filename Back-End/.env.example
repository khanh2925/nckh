# Sao chép thành ".env" trong thư mục Back-End và điền giá trị. ".env" không được commit.
# Neon cho "postgresql://USER:PASSWORD@HOST/DB?sslmode=require"; với Java viết:
#   DB_URL=jdbc:postgresql://HOST/DB?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/airport_map
DB_USERNAME=airport_map
DB_PASSWORD=
# Tài khoản quản trị hệ thống đầu tiên, chỉ dùng khi bảng users còn trống
ADMIN_EMAIL=admin@indoormap.local
ADMIN_PASSWORD=
# Tuỳ chọn: chuỗi ngẫu nhiên dài để token còn hiệu lực sau khi khởi động lại
JWT_SECRET=
# Tuỳ chọn: theo dõi lỗi (DSN của project Spring Boot trên Sentry / GlitchTip). Trống = tắt
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
