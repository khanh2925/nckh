# Production build (GitHub Actions variable): address of the Render backend, without /api and without a trailing /.
# Never put database passwords in VITE_ variables: they end up in the public website code.
VITE_API_BASE_URL=https://YOUR-SERVICE.onrender.com
# Optional error tracking: DSN of the React project on Sentry / GlitchTip. Empty = off and left out of the build
# VITE_SENTRY_DSN=https://KEY@oXXXX.ingest.sentry.io/PROJECT
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_REPLAY=1   (session replay on error, adds ~40 KB gzipped)
