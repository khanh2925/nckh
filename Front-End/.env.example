# Bản build production (biến của GitHub Actions): địa chỉ backend Render, không có /api và không có / ở cuối.
# Bỏ trống = website tĩnh đọc public/data/*.json (tạo bằng "npm run export-data").
# Không bao giờ đặt mật khẩu CSDL vào biến VITE_: chúng nằm trong mã website công khai.
VITE_API_BASE_URL=https://YOUR-SERVICE.onrender.com
# "static" = chỉ đọc bản chụp tĩnh, không gọi API (dùng khi trình diễn không có mạng/backend)
# VITE_DATA_MODE=static
# Tuỳ chọn: theo dõi lỗi (DSN của project React trên Sentry / GlitchTip). Trống = tắt, không tải thư viện
# VITE_SENTRY_DSN=https://KEY@oXXXX.ingest.sentry.io/PROJECT
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_REPLAY=1   (ghi lại phiên dùng khi có lỗi, nặng thêm ~40 KB nén)
